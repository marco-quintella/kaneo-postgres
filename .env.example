# Kaneo — variáveis do template (Railway injeta via wizard)
# Copie e preencha para rodar localmente com Docker Compose.

# Obrigatórias
DATABASE_URL=postgresql://kaneo:CHANGE_ME@localhost:5432/kaneo
AUTH_SECRET=CHANGE_ME # openssl rand -hex 32
KANEO_CLIENT_URL=http://localhost:5173

# Obrigatória no Railway (roteia healthcheck/tráfego) — default fixo
PORT=5173

# Opcionais
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
